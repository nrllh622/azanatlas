{
  "expo": {
    "name": "azanatlas",
    "slug": "azanatlas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.azanatlas.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AzanAtlas, bulunduğun konuma göre doğru ezan vakitlerini gösterebilmek için konumunu kullanır.",
        "NSUserTrackingUsageDescription": "Bu izin, sana daha ilgili reklamlar gösterebilmemiz için kullanılır. İzin vermesen de uygulamayı normal şekilde kullanabilirsin."
      }
    },
    "android": {
      "package": "com.azanatlas.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-updates",
      "./plugins/withCleanAndroidManifest",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/bip.wav",
            "./assets/sounds/dong.wav",
            "./assets/sounds/melodi1.wav",
            "./assets/sounds/melodi2.wav",
            "./assets/sounds/melodi3.wav",
            "./assets/sounds/uyandirma1.wav",
            "./assets/sounds/yuksek_siren.wav",
            "./assets/sounds/uyandirma3.wav",
            "./assets/sounds/kus_sesi1.wav",
            "./assets/sounds/ding_dong.wav",
            "./assets/sounds/allah_akbar_tekbir.mp3",
            "./assets/sounds/allahu_akbar_1.mp3",
            "./assets/sounds/allahu_akbar_2.mp3",
            "./assets/sounds/allahu_akbar_twice.mp3",
            "./assets/sounds/alahu_akbar_kethira.mp3",
            "./assets/sounds/lailaha_illallah.mp3",
            "./assets/sounds/esselatu_hayrun_minen_nevm.mp3",
            "./assets/sounds/adhanazan_short_1.mp3",
            "./assets/sounds/adhanazan_short_2.mp3",
            "./assets/sounds/ney_huzur.mp3"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "AzanAtlasWidget",
              "label": "AzanAtlas — Namaz Vakitleri",
              "description": "Bugünün yedi namaz vaktini gösterir.",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2984878117732696~1126374204",
          "iosAppId": "ca-app-pub-2984878117732696~1126374204"
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
